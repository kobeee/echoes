{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "xcodebuild": {
      "command": [
        "npx",
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "ios-simulator": {
      "command": [
        "npx",
        "-y",
        "ios-simulator-mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  }
}
